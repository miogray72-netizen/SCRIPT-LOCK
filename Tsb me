-- Confirm Logic
local confirming = false

ConfirmButton.MouseButton1Click:Connect(function()
    if confirming then
        return
    end

    confirming = true

    local inputKey = KeyBox.Text

    -- Verify Game ID
    if game.PlaceId ~= TARGET_GAME_ID then
        setStatus(
            "Error: Invalid Game ID! Required: 10449761463",
            Color3.fromRGB(255, 60, 60)
        )

        confirming = false
        return
    end

    -- Verify Key
    if inputKey ~= VALID_KEY then
        setStatus(
            "Error: Incorrect Key! Please try again.",
            Color3.fromRGB(255, 60, 60)
        )

        confirming = false
        return
    end

    setStatus(
        "Key accepted! Loading script...",
        Color3.fromRGB(0, 255, 120)
    )

    task.wait(1.5)

    -- Closing Animation
    local closeTween = TweenService:Create(
        MainFrame,
        TweenInfo.new(
            0.4,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.In
        ),
        {
            Size = UDim2.new(0, 0, 0, 0),
            Position = UDim2.new(0.5, 0, 0.5, 0)
        }
    )

    closeTween:Play()
    closeTween.Completed:Wait()

    -- Cleanup
    running = false
    ScreenGui:Destroy()

    -- Script 2 Loading
    task.spawn(function()
        local success, result = pcall(function()
            local source = game:HttpGet(SCRIPT_2_URL)

            if not source or source == "" then
                error("Script source is empty")
            end

            local compiled = loadstring(source)

            if not compiled then
                error("Failed to compile Script 2")
            end

            compiled()
        end)

        if not success then
            warn("[NHATCO] Script 2 Error:", result)
        end
    end)
end)
