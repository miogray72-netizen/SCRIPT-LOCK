-- Lấy số lượng Wins hiện tại của người chơi
local function getPlayerWins()
    local leaderstats = player:FindFirstChild("leaderstats")
    if not leaderstats then
        return 0, false
    end

    local winsValueObj = leaderstats:FindFirstChild("Wins")
    if not winsValueObj then
        return 0, false
    end

    local rawValue = winsValueObj.Value
    local numericWins = tonumber(rawValue) or 0
    return numericWins, true
end

-- Cập nhật hiển thị số lượng Wins lên UI
local function refreshWinsUI()
    if not winsLabel.Parent then
        return
    end

    local wins, found = getPlayerWins()
    if not found then
        winsLabel.Text = "★ WINS: LOADING...  (EGG REQ: " .. CONFIG.MIN_WINS_FOR_EGG .. ")"
        winsLabel.TextColor3 = Color3.fromRGB(185, 185, 195)
        return
    end

    local enough = wins >= CONFIG.MIN_WINS_FOR_EGG
    winsLabel.Text = string.format(
        "★ WINS: %d  (%s)",
        wins,
        enough and "READY FOR EGG" or ("NEED " .. CONFIG.MIN_WINS_FOR_EGG)
    )
    winsLabel.TextColor3 = enough
        and Color3.fromRGB(135, 235, 160)
        or Color3.fromRGB(255, 195, 100)
end

-- Cập nhật dòng trạng thái tổng hợp
local function updateStatusDisplay()
    if not status.Parent then
        return
    end

    local wins = getPlayerWins()
    local enoughWins = wins >= CONFIG.MIN_WINS_FOR_EGG

    local activeParts = {}
    if enabled then
        table.insert(activeParts, "TELE")
    end
    if holdWEnabled then
        table.insert(activeParts, "HOLD W")
    end
    if autoEggEnabled then
        if enoughWins then
            table.insert(activeParts, "EGG X10")
        else
            table.insert(activeParts, string.format("EGG PAUSED (%d/%d WINS)", wins, CONFIG.MIN_WINS_FOR_EGG))
        end
    end

    if #activeParts > 0 then
        status.Text = "● " .. table.concat(activeParts, " + ")
        if autoEggEnabled and not enoughWins then
            status.TextColor3 = Color3.fromRGB(255, 185, 95)
        else
            status.TextColor3 = Color3.fromRGB(150, 230, 170)
        end
    else
        status.Text = "● SYSTEM READY"
        status.TextColor3 = Color3.fromRGB(190, 220, 195)
    end
end

-- Lắng nghe thay đổi của leaderstats.Wins theo thời gian thực
local winsChangedConn = nil
local function bindWinsListener()
    if winsChangedConn then
        winsChangedConn:Disconnect()
        winsChangedConn = nil
    end

    local leaderstats = player:FindFirstChild("leaderstats") or player:WaitForChild("leaderstats", 15)
    if not leaderstats then
        return
    end

    local winsObj = leaderstats:FindFirstChild("Wins") or leaderstats:WaitForChild("Wins", 15)
    if not winsObj then
        return
    end

    refreshWinsUI()
    updateStatusDisplay()

    winsChangedConn = winsObj.Changed:Connect(function()
        refreshWinsUI()
        updateStatusDisplay()
    end)
end

task.spawn(bindWinsListener)

-- Lấy Humanoid và HumanoidRootPart an toàn
local function getCharacterRig()
    local character = player.Character
    if not character then
        return nil, nil
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root or humanoid.Health <= 0 then
        return nil, nil
    end

    return humanoid, root
end

-- Nhả giữ W khi tắt hoặc huỷ GUI
local function releaseHoldW()
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid:Move(Vector3.zero, false)
    end
end

-- Hàm lấy CFrame của WinPortal nếu bật FOLLOW_PORTAL_OBJECT
local function getPortalCFrame()
    local current = workspace
    for _, name in ipairs(CONFIG.PORTAL_PATH) do
        current = current:FindFirstChild(name)
        if not current then
            return nil
        end
    end

    if current:IsA("BasePart") then
        return current.CFrame + Vector3.new(0, 3, 0)
    elseif current:IsA("Model") then
        return current:GetPivot() + Vector3.new(0, 3, 0)
    end

    return nil
end

-- Hàm dịch chuyển nhân vật
local function teleportStep()
    local humanoid, root = getCharacterRig()
    if not humanoid or not root then
        return false
    end

    local target = CONFIG.TARGET_CFRAME
    if CONFIG.FOLLOW_PORTAL_OBJECT then
        local portalCF = getPortalCFrame()
        if portalCF then
            target = portalCF
        end
    end

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    root.CFrame = target
    return true
end

-- Lấy RemoteFunction EggService
local eggRemote = nil
local function getEggRemote()
    if eggRemote and eggRemote.Parent then
        return eggRemote
    end

    local commonModules = ReplicatedStorage:FindFirstChild("CommonModules")
    local systems = commonModules and commonModules:FindFirstChild("Systems")
    local networkSystem = systems and systems:FindFirstChild("NetworkSystem")
    local network = networkSystem and networkSystem:FindFirstChild("Network")
    eggRemote = network and network:FindFirstChild("RemoteFunction")
    return eggRemote
end

-- Gọi sự kiện mở Egg10 (chỉ gọi khi đủ >= 30 Wins)
local EGG_PAYLOAD = {
    {
        name = "Egg10",
        type = "Egg"
    },
    {
        name = "Egg10",
        type = "Egg"
    },
    {
        name = "Egg10",
        type = "Egg"
    }
}

local function openEggStep()
    local wins = getPlayerWins()
    if wins < CONFIG.MIN_WINS_FOR_EGG then
        return false
    end

    local remote = getEggRemote()
    if not remote or not remote:IsA("RemoteFunction") then
        return false
    end

    local ok = pcall(function()
        remote:InvokeServer("EggService.open", EGG_PAYLOAD)
    end)
    return ok
end

